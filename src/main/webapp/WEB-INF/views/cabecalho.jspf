<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<fmt:setLocale value="pt_BR"/>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>${param.titulo} · Antiquário Melodia</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Lato:wght@400;700&amp;display=swap" rel="stylesheet">
	<link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilo.css">
</head>
<body>
<header class="topo">
	<div class="container topo-conteudo">
		<a class="marca" href="${pageContext.request.contextPath}/produtos">
			<span class="marca-icone" aria-hidden="true">♪</span>
			<span>
				<strong>Antiquário Melodia</strong>
				<small>Vitrolas · Discos · Instrumentos</small>
			</span>
		</a>
		<nav class="menu">
			<a href="${pageContext.request.contextPath}/produtos">Acervo</a>
			<a class="botao botao-destaque" href="${pageContext.request.contextPath}/produtos?acao=novo">+ Novo item</a>
		</nav>
	</div>
</header>
<main class="container">
